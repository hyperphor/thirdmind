;; ThirdMind config for the AMMDI graph. Commands take it as their first argument, or find it as the
;; only file in config/ (or $THIRDMIND_CONFIG): lein watch, lein serve, lein times, lein blyg ...
{:graph  "/opt/mt/repos/ammdi"
 :db     "ammdi.db"                     ; relative to the thirdmind dir
 :port   2284                           ; lein serve
 :write? true                           ; lein watch runs graph-writing actions (smart URLs, #AskClaude)

 :blygger
 {:goddinpotty "/opt/mt/repos/goddinpotty/resources/ammdi-config.edn" ; site URL, output dir, exit tags
  :state       "/opt/mt/repos/ammdi/.thirdmind-blyg-state.edn"
  :ids-backup  "/opt/mt/repos/ammdi/.thirdmind-ids.edn"
  :site-repo   "/opt/mt/repos/hyperphor-git"
  :mount       "ammdi/blyg"                                       ; the blyg's dir in site-repo
  :remote      "website"
  :auto-publish? true                                             ; lein watch publishes + pushes #blyg edits
  :quiet-ms    120000}                                            ; ... once they've been still this long

 ;; lein site (design/static-site.md). Exit tags, main page and output dir come from goddinpotty's
 ;; config until cutover, so blyg and the site share one exit-tag list.
 :site
 {:goddinpotty "/opt/mt/repos/goddinpotty/resources/ammdi-config.edn"
  :entry-tags  ["EntryPoint"]
  :entry-pages ["Index"]                                          ; navbar pages, besides the main page
  :build-dir   "target/site"                                      ; lein site build; not the live site until cutover
  :static-dir  "/opt/mt/repos/goddinpotty/resources/public"       ; css/js copied into assets/
  :twin-cache  "/opt/mt/repos/goddinpotty/.enduro.d/twin-pages-content"  ; goddinpotty's fetch caches, read only
  :tweet-cache "/opt/mt/repos/goddinpotty/.enduro.d/embed-twitter"
  :short-title "AMMDI"
  :description "AMMDI is an open-notebook hypertext writing experiment aka digital garden, authored by Mike Travers"
  :google-analytics "G-SK8PZVFHTW"
  :site-css    ["assets/hyper-roam.css"]
  :navbar      [["All Pages" "Index"]]
  :colophon    ["Copyright © " [:a {:href "http://hyperphor.com" :style "color: white;"} "Hyperphor"] " 2020-2026"]}}
