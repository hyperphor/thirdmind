;; A minimal ThirdMind config for publishing a Logseq graph as a static site.
;; Copy it to config/<name>.edn and edit. Commands find it as the only .edn file directly in
;; config/, or take its path as their first argument, or read $THIRDMIND_CONFIG.
{:graph "/path/to/your/logseq-graph"   ; the folder holding pages/ and journals/
 ;; :db    "mygraph.db"                ; default <graph folder name>.db, relative to where you run lein
 ;; :realm "mygraph"                   ; default the graph folder name

 :site
 {:main-page   "Home"                  ; required: the site's front page (index.html redirects to it)
  :build-dir   "target/site"           ; where `lein site build` writes
  :base-url    "https://example.com/notes/"  ; the published URL of build-dir, for og:url tags

  ;; What gets published. The walk starts at the main page, :entry-pages, pages with
  ;; public:: true, and pages tagged with an :entry-tag, then follows links, stopping at
  ;; journals and anything carrying an exit tag (one in a top-level block hides the whole page).
  :exit-tags   ["Private"]             ; the default when unset; add your own
  ;; :entry-tags  ["EntryPoint"]
  ;; :entry-pages ["About"]

  ;; Look and navigation (all optional)
  ;; :short-title "My Notes"           ; prefixed to each page's <title>
  ;; :description "..."                ; og:description
  ;; :navbar      [["All Pages" "Index"]]   ; [label page-name] links beside the main page
  ;; :colophon    ["Copyright © 2026 Me"]   ; footer, as hiccup
  ;; :site-css    ["assets/hyper-roam.css"]  ; extra stylesheets, linked after the built-in ones
  ;; :page-suffix ".html"             ; page files as Foo.html, links still Foo (GitHub Pages, Netlify)
  ;; :static-dir  "/path/to/assets"     ; files copied into assets/, replacing bundled ones of the same name
  ;; :google-analytics "G-XXXXXXX"
  }}
