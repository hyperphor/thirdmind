;; ThirdMind config for the demo graph in demo/graph:  lein site build demo/config.edn
;; For your own graph, copy it to config/<name>.edn and edit. Commands find a config as their first
;; argument, as the only .edn file in config/, or in $THIRDMIND_CONFIG. Relative paths are relative
;; to where you run lein.
{:graph "demo/graph"                   ; the folder holding pages/ and journals/
 :db    "target/demo.db"               ; default <graph folder name>.db
 ;; :realm "mygraph"                   ; default the graph folder name

 :site
 {:main-page   "Welcome"               ; required: the site's front page (index.html redirects to it)
  :build-dir   "target/demo-site"      ; where `lein site build` writes; default target/site
  :base-url    "https://example.com/demo/"  ; the published URL of build-dir, for og:url tags
  :page-suffix ".html"                 ; page files as Foo.html, links still Foo (GitHub Pages, Netlify, local preview)

  ;; What gets published. The walk starts at the main page, :entry-pages, pages with
  ;; public:: true, and pages tagged with an :entry-tag, then follows links, stopping at
  ;; journals and anything carrying an exit tag (one in a top-level block hides the whole page).
  :exit-tags   ["Private"]             ; the default when unset; add your own
  :entry-tags  ["Featured"]
  ;; :entry-pages ["About"]

  ;; Look and navigation (all optional)
  :short-title "ThirdMind demo"        ; prefixed to each page's <title>
  :description "A demo of publishing a Logseq graph with ThirdMind"   ; og:description
  :navbar      [["All Pages" "Index"] ["Map" "Map"]]   ; [label page-name] links beside the main page
  :colophon    ["Built with " [:a {:href "https://github.com/hyperphor/thirdmind" :style "color: white;"} "ThirdMind"]]  ; footer, as hiccup
  :site-css    ["assets/hyper-roam.css"]  ; extra stylesheets, linked after the built-in ones
  ;; :static-dir  "/path/to/assets"     ; files copied into assets/, replacing bundled ones of the same name
  ;; :google-analytics "G-XXXXXXX"
  }}
